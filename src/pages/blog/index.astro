---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { readTime } from '../../config';
const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Journal"><h1>Journal & Transmissions</h1><div class="grid">
{posts.map((p) => <a class="card" href={`/blog/${p.id}`} style="text-decoration:none;color:inherit"><h3>{p.data.title}</h3><p>{p.data.description}</p>
<small>{p.data.date.toLocaleDateString('fr-FR')} · {readTime(p.body)} min</small><br />{p.data.tags.map((t) => <span class="tag">#{t}</span>)}</a>)}</div></Base>
