---
import Stickers from '../components/Stickers.astro';
const { title = 'Alexandre Bourdonneau' } = Astro.props;
const path = Astro.url.pathname;
const nav = [['/', 'Home'], ['/#academy', 'Academy & Lab'], ['/blog', 'Journal'], ['/#guestbook', 'Chat']];
---
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🛸</text></svg>"></head>
<body>
<div class="glow" id="glow"></div>
<nav class="capsule">{nav.map(([h, l]) => <a href={h} class:list={[{ on: path === h }]}>{l}</a>)}<button id="snd" title="Son rétro">🔇</button></nav>
<main><slot /></main>
<Stickers />
<footer>© {new Date().getFullYear()} Alexandre Bourdonneau · built with Astro ✦</footer>
<script>
  const g = document.getElementById('glow')!;
  addEventListener('pointermove', (e) => { g.style.transform = `translate(${e.clientX - 150}px,${e.clientY - 150}px)`; });
  let on = localStorage.getItem('snd') === '1'; const b = document.getElementById('snd')!;
  const show = () => (b.textContent = on ? '🔊' : '🔇'); show();
  let ac: AudioContext | null = null;
  const blip = (f = 660) => { if (!on) return; ac ??= new AudioContext(); const o = ac.createOscillator(), v = ac.createGain(); o.type = 'square'; o.frequency.value = f; v.gain.value = 0.03; o.connect(v); v.connect(ac.destination); o.start(); o.stop(ac.currentTime + 0.06); };
  b.onclick = () => { on = !on; localStorage.setItem('snd', on ? '1' : '0'); show(); blip(880); };
  document.querySelectorAll('a,button').forEach((el) => el.addEventListener('pointerenter', () => blip(520)));
  (window as any).blip = blip;
</script>
</body></html>
<style is:global>
:root{--bg:#0b0d13;--fg:#e6e9f2;--mut:#8a90a6;--c1:#7df9ff;--c2:#ff7ae6;--glass:rgba(255,255,255,.06)}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.65 'Courier New',ui-monospace,monospace;min-height:100vh;
background-image:linear-gradient(rgba(125,249,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(125,249,255,.05) 1px,transparent 1px);background-size:40px 40px;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0;background:radial-gradient(ellipse at 50% 0,transparent 30%,var(--bg) 85%);pointer-events:none;z-index:0}
.glow{position:fixed;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(255,122,230,.14),transparent 65%);pointer-events:none;z-index:0;top:0;left:0}
main{position:relative;z-index:1;max-width:860px;margin:0 auto;padding:110px 20px 40px}
a{color:var(--c1)}h1,h2{letter-spacing:.02em}h2{margin-top:56px}h2::before{content:"// ";color:var(--c2)}
.capsule{position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:50;display:flex;gap:4px;padding:6px;border-radius:999px;background:var(--glass);backdrop-filter:blur(14px) saturate(1.4);border:1px solid rgba(125,249,255,.3);box-shadow:0 0 24px rgba(125,249,255,.15),inset 0 1px 0 rgba(255,255,255,.25);max-width:96vw;overflow-x:auto}
.capsule a,.capsule button{color:var(--fg);text-decoration:none;padding:6px 14px;border-radius:999px;font:inherit;font-size:14px;background:none;border:0;cursor:pointer;white-space:nowrap}
.capsule a:hover,.capsule a.on,.capsule button:hover{background:rgba(125,249,255,.15);box-shadow:0 0 12px rgba(255,122,230,.35)}
.card{background:var(--glass);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:18px;backdrop-filter:blur(8px);transition:.2s}
.card:hover{border-color:var(--c2);transform:translateY(-3px);box-shadow:0 0 20px rgba(255,122,230,.2)}
.tag{display:inline-block;font-size:12px;padding:2px 10px;margin:0 6px 6px 0;border-radius:999px;border:1px solid var(--c1);color:var(--c1)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.prose{max-width:70ch}.prose code{background:var(--glass);padding:1px 6px;border-radius:6px}.prose pre{background:#070910;padding:14px;border-radius:12px;overflow:auto}
input,select,button.btn{font:inherit;color:var(--fg);background:var(--glass);border:1px solid rgba(255,255,255,.2);border-radius:10px;padding:8px 12px}
button.btn{cursor:pointer;border-color:var(--c1)}button.btn:hover{box-shadow:0 0 12px var(--c1)}
footer{position:relative;z-index:1;text-align:center;color:var(--mut);padding:40px 0 100px;font-size:13px}
</style>
